#!/usr/bin/env bash
#
# bin/syssentry — SysSentry CLI Dispatcher (Main Entrypoint)
#
# High-performance Linux CLI system utility for real-time resource monitoring,
# rogue process governance, and automated resource-safe incremental backups.
#
# Subcommands:
#   monitor   Capture and display a system resource snapshot
#   backup    Run a timestamped full/incremental backup
#   guard     All-in-one: monitor + backup (if healthy) + optional governance
#   clean     Run retention cleanup on backup archives
#   --help    Show help
#   --version Show version
#   --dry-run Simulate actions without making changes
#
# Namespace: CLI::

set -euo pipefail

###############################################################################
# Bootstrap: locate library and config relative to this script
###############################################################################
SENTRY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SENTRY_LIB="${SENTRY_ROOT}/lib"
SENTRY_CONFIG="${SENTRY_CONFIG:-${SENTRY_ROOT}/config/syssentry.conf}"

source "${SENTRY_LIB}/core.sh"
source "${SENTRY_LIB}/monitor.sh"
source "${SENTRY_LIB}/process.sh"
source "${SENTRY_LIB}/backup.sh"

declare DRY_RUN=false

###############################################################################
# CLI::print_help
#
# Prints usage information, subcommands, global options, and examples to
# stdout using ANSI colour codes.
#
# @return Core_EXIT_SUCCESS
###############################################################################
CLI::print_help() {
    cat <<EOF
${Core_C_BOLD}${Core_C_CYAN}SysSentry${Core_C_RESET} v${Core_VERSION}
A high-performance Linux CLI system utility for real-time resource monitoring,
rogue process governance, and automated resource-safe incremental backups.

${Core_C_BOLD}USAGE:${Core_C_RESET}
  syssentry <subcommand> [options] [--dry-run]

${Core_C_BOLD}SUBCOMMANDS:${Core_C_RESET}
  monitor     Capture and display a real-time system resource snapshot
              (RAM, CPU load, IO wait, health state)

  backup      Run a timestamped full or incremental backup
              Usage: syssentry backup <source> <dest> [full|incremental]

  guard       All-in-one check: monitor health, run backup if safe,
              and govern rogue processes

  clean       Prune backup archives older than the retention window

${Core_C_BOLD}GLOBAL OPTIONS:${Core_C_RESET}
  --dry-run   Simulate actions without modifying the system
  --help      Show this help message
  --version   Show version information

${Core_C_BOLD}EXAMPLES:${Core_C_RESET}
  syssentry monitor
  syssentry backup /home /var/backups/syssentry full
  syssentry backup /var/www /mnt/backups incremental
  syssentry guard --dry-run
  syssentry clean /var/backups/syssentry 7
  syssentry --version

${Core_C_BOLD}CONFIG:${Core_C_RESET}
  Edit ${SENTRY_CONFIG} (or copy config/syssentry.conf.example)
  to tune thresholds, paths, and retention.

${Core_C_BOLD}REPOSITORY:${Core_C_RESET}
  https://github.com/0xSenior/SysSentry

EOF

    return "${Core_EXIT_SUCCESS}"
}

###############################################################################
# CLI::cmd_monitor
#
# Captures a system resource snapshot and renders it to the terminal.
#
# @return Core_EXIT_SUCCESS
###############################################################################
CLI::cmd_monitor() {
    Core::banner "System Monitor"
    Monitor::capture_snapshot
    Monitor::display_snapshot
    Core::log INFO "Monitor check complete (state=${Core_SYSTEM_SNAPSHOT[health_state]})"
    return "${Core_EXIT_SUCCESS}"
}

###############################################################################
# CLI::cmd_backup
#
# Runs the backup pre-flight safety gate, then performs a full or incremental
# backup if the system is not under critical resource pressure.
#
# @param source source directory to archive
# @param dest destination directory for the archive
# @param type full|incremental (default: full)
# @return Core_EXIT_SUCCESS on success, non-zero on pre-flight or backup failure
###############################################################################
CLI::cmd_backup() {
    local -r _source="${1:-}"
    local -r _dest="${2:-}"
    local -r _type="${3:-full}"

    if [[ -z "${_source}" || -z "${_dest}" ]]; then
        Core::log ERROR "Usage: syssentry backup <source> <dest> [full|incremental]"
        return "${Core_ERR_USAGE}"
    fi

    Core::banner "Backup Engine"

    if ! Backup::pre_flight_check "${DRY_RUN}"; then
        Core::log ERROR "Backup aborted due to CRITICAL system health"
        return "${Core_ERR_RESOURCE_PRESSURE}"
    fi

    Backup::run_backup "${_source}" "${_dest}" "${_type}" "${DRY_RUN}"
}

###############################################################################
# CLI::cmd_guard
#
# All-in-one guard cycle: monitor system health, run backup if safe, and
# optionally govern rogue processes.
#
# @param source backup source directory (default from config)
# @param dest backup destination directory (default from config)
# @param govern "true" to run process governance (default: true)
# @return Core_EXIT_SUCCESS
###############################################################################
CLI::cmd_guard() {
    local -r _source="${1:-${Core_CONFIG[backup_source]:-/home}}"
    local -r _dest="${2:-${Core_CONFIG[backup_dest]:-/var/backups/syssentry}}"
    local -r _govern="${3:-true}"

    Core::banner "Guard (All-in-One)"

    Core::log INFO "Guard step 1/3: monitoring system health"
    Monitor::capture_snapshot
    Monitor::display_snapshot

    Core::log INFO "Guard step 2/3: backup pre-flight"
    if Backup::pre_flight_check "${DRY_RUN}"; then
        Backup::run_backup "${_source}" "${_dest}" "incremental" "${DRY_RUN}"
    else
        Core::log WARN "Guard: skipping backup (CRITICAL health)"
    fi

    if [[ "${_govern}" == "true" ]]; then
        Core::log INFO "Guard step 3/3: process governance"
        Process::govern \
            "${Core_CONFIG[warn_mem_percent_proc]:-10}" \
            "${Core_CONFIG[warn_cpu_percent_proc]:-10}" \
            "${Core_CONFIG[grace_seconds]:-5}"
    fi

    Core::log INFO "Guard cycle complete"
    return "${Core_EXIT_SUCCESS}"
}

###############################################################################
# CLI::cmd_clean
#
# Runs retention cleanup on the backup destination directory.
#
# @param dest backup destination directory (default from config)
# @param days retention window in days (default from config)
# @return Core_EXIT_SUCCESS
###############################################################################
CLI::cmd_clean() {
    local -r _dest="${1:-${Core_CONFIG[backup_dest]:-/var/backups/syssentry}}"
    local -r _days="${2:-${Core_CONFIG[retention_days]:-7}}"

    Core::banner "Retention Cleaner"
    Backup::retention_clean "${_dest}" "${_days}" "${DRY_RUN}"
}

###############################################################################
# CLI::main
#
# Parses global options and dispatches to the requested subcommand. Remaining
# positional arguments are forwarded to the subcommand handler.
#
# @param args command-line arguments
# @return Core_EXIT_SUCCESS, Core_ERR_USAGE on unknown argument
###############################################################################
CLI::main() {
    local _subcommand=""
    local -a _positional=()

    if [[ $# -eq 0 ]]; then
        CLI::print_help
        return "${Core_EXIT_SUCCESS}"
    fi

    # Scan all arguments: global options can appear before or after the
    # subcommand. Positional arguments after the subcommand are collected
    # and forwarded to the subcommand handler.
    while [[ $# -gt 0 ]]; do
        case "${1}" in
            --dry-run)
                DRY_RUN=true
                shift
                ;;
            --help|-h)
                CLI::print_help
                return "${Core_EXIT_SUCCESS}"
                ;;
            --version|-v)
                printf '%s v%s\n' "${Core_PROJECT_NAME}" "${Core_VERSION}"
                return "${Core_EXIT_SUCCESS}"
                ;;
            monitor|backup|guard|clean)
                if [[ -n "${_subcommand}" ]]; then
                    Core::log ERROR "Multiple subcommands specified"
                    return "${Core_ERR_USAGE}"
                fi
                _subcommand="${1}"
                shift
                ;;
            *)
                _positional+=("${1}")
                shift
                ;;
        esac
    done

    case "${_subcommand}" in
        monitor)
            CLI::cmd_monitor "${_positional[@]+"${_positional[@]}"}"
            ;;
        backup)
            CLI::cmd_backup "${_positional[@]+"${_positional[@]}"}"
            ;;
        guard)
            CLI::cmd_guard "${_positional[@]+"${_positional[@]}"}"
            ;;
        clean)
            CLI::cmd_clean "${_positional[@]+"${_positional[@]}"}"
            ;;
        *)
            CLI::print_help
            return "${Core_EXIT_SUCCESS}"
            ;;
    esac
}

###############################################################################
# Entry point
###############################################################################
Core::init
CLI::main "$@"
